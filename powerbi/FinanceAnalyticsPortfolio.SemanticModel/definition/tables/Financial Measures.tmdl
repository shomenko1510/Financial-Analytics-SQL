table 'Financial Measures'
	lineageTag: cb9e4207-9e3b-4adb-8983-3784f646e89e

	measure 'Actual Amount' =
			
			SUM(
			    vw_ActualVsBudget[ActualAmount]
			)
		lineageTag: 3d9c3790-4ce1-4935-87c3-8972acebe8fc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Budget Amount' =
			
			SUM(
			    vw_ActualVsBudget[BudgetAmount]
			)
		lineageTag: ff05ba6c-7951-4025-bbac-2de2ae249539

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variance Amount' =
			
			[Actual Amount]
			-
			[Budget Amount]
		lineageTag: 7068a36d-f193-4b77-9a81-de1c43a87394

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variance %' =
			DIVIDE(
			    [Variance Amount],
			    [Budget Amount],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6e2247f4-f8ee-49aa-bb80-c4c11a35e46d

	measure 'Revenue Actual' =
			
			CALCULATE(
			    [Actual Amount],
			    DimIndicator[IndicatorCode] = "REV_EX_VAT"
			)
		lineageTag: 886fbdfe-e8f8-440b-9880-4c74e4ec59cd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue Budget' =
			
			CALCULATE(
			    [Budget Amount],
			    DimIndicator[IndicatorCode] = "REV_EX_VAT"
			)
		lineageTag: beba6fbf-bcf7-4d31-84e9-b98951f9eff3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Profit Actual' =
			
			CALCULATE(
			    [Actual Amount],
			    DimIndicator[IndicatorCode] = "NP"
			)
		lineageTag: 7fc9d0e7-95c8-4c1b-9d60-5daf136f8aef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'OCF Actual' =
			
			CALCULATE(
			    [Actual Amount],
			    DimIndicator[IndicatorCode] = "OCF"
			)
		lineageTag: a6b37f22-3336-40f4-a560-e730cd65acf2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Closing Cash Actual' =
			
			CALCULATE(
			    [Actual Amount],
			    DimIndicator[IndicatorCode] = "CASH_CLOSE"
			)
		lineageTag: 83a7413b-595f-4492-91ad-56fc5390259d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'EBITDA Actual' = ```
			
			VAR ProfitBeforeTax =
			    CALCULATE(
			        [Actual Amount],
			        REMOVEFILTERS(DimIndicator),
			        DimIndicator[IndicatorCode] = "PBT"
			    )
			
			VAR Depriciation = 
			    CALCULATE(
			        [Actual Amount],
			        REMOVEFILTERS(DimIndicator),
			        DimIndicator[IndicatorCode] = "DEPR"
			    )
			
			VAR FinancialExpenses = 
			    CALCULATE(
			        [Actual Amount],
			        REMOVEFILTERS(DimIndicator),
			        DimIndicator[IndicatorCode] = "FIN_EXP"
			    )
			
			VAR OtherFinancialIncome =
			    CALCULATE(
			        [Actual Amount],
			        REMOVEFILTERS(DimIndicator),
			        DimIndicator[IndicatorCode] = "OTHER_FIN_INC"
			    )
			
			RETURN
			    ProfitBeforeTax
			    + Depriciation
			    + FinancialExpenses
			    -OtherFinancialIncome
			
			```
		lineageTag: 7be1e131-bf50-466e-bc8c-e976a067604b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'EBITDA Budget' = ```
			
			VAR ProfitBeforeTax =
			    CALCULATE(
			        [Budget Amount],
			        REMOVEFILTERS(DimIndicator),
			        DimIndicator[IndicatorCode] = "PBT"
			    )
			
			VAR Depriciation = 
			    CALCULATE(
			        [Budget Amount],
			        REMOVEFILTERS(DimIndicator),
			        DimIndicator[IndicatorCode] = "DEPR"
			    )
			
			VAR FinancialExpenses = 
			    CALCULATE(
			        [Budget Amount],
			        REMOVEFILTERS(DimIndicator),
			        DimIndicator[IndicatorCode] = "FIN_EXP"
			    )
			
			VAR OtherFinancialIncome =
			    CALCULATE(
			        [Budget Amount],
			        REMOVEFILTERS(DimIndicator),
			        DimIndicator[IndicatorCode] = "OTHER_FIN_INC"
			    )
			
			RETURN
			    ProfitBeforeTax
			    + Depriciation
			    + FinancialExpenses
			    -OtherFinancialIncome
			```
		lineageTag: 6534aef2-55b4-40a7-95e9-666b7b8cc75b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue Variance' = ```
			
