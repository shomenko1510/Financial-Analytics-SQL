	measure 'Working Capital Impact Actual' = ```
			
			VAR AR =
			    CALCULATE(
			        [Actual Amount],
			        REMOVEFILTERS(DimIndicator),
			        DimIndicator[IndicatorCode] = "CHG_AR"
			    )
			
			VAR Inventory =
			    CALCULATE(
			        [Actual Amount],
			        REMOVEFILTERS(DimIndicator),
			        DimIndicator[IndicatorCode] = "CHG_INV"
			    )
			
			VAR AP = 
			    CALCULATE(
			        [Actual Amount],
			        REMOVEFILTERS(DimIndicator),
			        DimIndicator[IndicatorCode] = "CHG_AP"
			    )
			
			RETURN
			     AR + Inventory - AP
			```
		lineageTag: 2849637c-7f2f-4874-9b9c-48db4493eb78

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Working Capital Impact Budget' =
			
			VAR AR =
			    CALCULATE(
			        [Budget Amount],
			        REMOVEFILTERS(DimIndicator),
			        DimIndicator[IndicatorCode] = "CHG_AR"
			    )
			
			VAR Inventory =
			    CALCULATE(
			        [Budget Amount],
			        REMOVEFILTERS(DimIndicator),
			        DimIndicator[IndicatorCode] = "CHG_INV"
			    )
			
			VAR AP =
			    CALCULATE(
			        [Budget Amount],
			        REMOVEFILTERS(DimIndicator),
			        DimIndicator[IndicatorCode] = "CHG_AP"
			    )
			
			RETURN AR + Inventory - AP
		lineageTag: 3abc9a1d-7ef9-46d9-9786-4c8ce15d7e41

