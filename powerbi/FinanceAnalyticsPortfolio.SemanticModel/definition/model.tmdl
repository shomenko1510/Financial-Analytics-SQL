model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: uk-UA
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["vw_FinancialReport","vw_ActualVsBudget","vw_GrossProfitAnalysis","vw_SalesPriceVolumeAnalysis","pServerName","pDatabaseName","vw_DebtAnalysis","vw_CapExAnalysis"]

annotation PBI_ProTooling = ["DevMode"]

ref table vw_FinancialReport
ref table vw_ActualVsBudget
ref table vw_GrossProfitAnalysis
ref table vw_SalesPriceVolumeAnalysis
ref table DimPeriod
ref table DimDirection
ref table DimIndicator
ref table 'Financial Measures'
ref table 'KPI Selector'
ref table 'Revenue Bridge'
ref table 'Working Capital Drivers'
ref table 'Cash Flow Structure'
ref table vw_DebtAnalysis
ref table vw_CapExAnalysis

ref cultureInfo en-US

